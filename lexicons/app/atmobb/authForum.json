{
  "lexicon": 1,
  "id": "app.atmobb.authForum",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "atmobb",
      "detail": "Post threads and replies, join forums, watch boards, vote in polls, customize your profile and signature, and ask atmo.pub to deliver your notifications.",
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "app.atmobb.discussion.thread",
            "app.atmobb.discussion.reply",
            "app.atmobb.forum.membership",
            "app.atmobb.forum.accessRequest",
            "app.atmobb.forum.watch",
            "app.atmobb.poll.vote",
            "app.atmobb.actor.profile"
          ]
        },
        {
          "type": "permission",
          "resource": "rpc",
          "lxm": ["pub.atmo.notify.requestPermission"],
          "inheritAud": true
        }
      ]
    }
  }
}
