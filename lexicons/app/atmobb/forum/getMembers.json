{
  "lexicon": 1,
  "id": "app.atmobb.forum.getMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Members of a forum ordered by postcount, with atmobb profiles.",
      "parameters": {
        "type": "params",
        "required": ["forum"],
        "properties": {
          "forum": { "type": "string", "format": "did" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["members"],
          "properties": {
            "members": { "type": "array", "items": { "type": "unknown" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
