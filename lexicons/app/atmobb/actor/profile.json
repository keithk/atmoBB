{
  "lexicon": 1,
  "id": "app.atmobb.actor.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's atmoBB account defaults and per-forum overrides. Lives in the user's repo.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "notifications": { "type": "boolean", "description": "Whether connected forums may notify this account. Defaults to true; never grants relay permission." },
          "forumProfiles": {
            "type": "array",
            "description": "Per-forum overrides for profile fields and notification preferences. Other fields inherit account defaults.",
            "items": { "type": "ref", "ref": "#forumProfile" }
          },
          "theme": {
            "type": "string",
            "description": "Personal color theme across forums. Omit to follow each forum's default styling.",
            "knownValues": ["classic", "sky", "bubblegum", "midnight", "forest"],
            "maxLength": 64
          },
          "forumThemes": {
            "type": "array",
            "description": "Per-forum personal theme overrides. Omit a forum to use the global theme; an empty theme preserves that forum's own styling.",
            "items": { "type": "ref", "ref": "#forumTheme" }
          },
          "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
          "description": {
            "type": "string",
            "description": "Default free-text bio, shown on the profile's About panel unless overridden for a forum.",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "avatar": { "type": "blob", "accept": ["image/png", "image/jpeg", "image/webp", "image/gif"], "maxSize": 1000000 },
          "signature": {
            "type": "array",
            "description": "Rendered under every post, phpBB style. Keep it short; clients may truncate.",
            "maxLength": 3,
            "items": {
              "type": "union",
              "refs": ["app.atmobb.richtext.block#text", "app.atmobb.richtext.block#quote", "app.atmobb.richtext.block#code", "app.atmobb.richtext.block#image"]
            }
          },
          "title": {
            "type": "string",
            "description": "Self-chosen user title, shown under the username where the forum allows it.",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "pronouns": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
          "website": { "type": "string", "format": "uri" },
          "avatarBuilder": {
            "type": "ref",
            "ref": "#avatarBuilder",
            "description": "Legacy layered-avatar recipe from an earlier builder. atmobb ignores it; clients should read the `avatar` blob."
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "forumProfile": {
      "type": "object",
      "required": ["forum", "fields"],
      "properties": {
        "forum": { "type": "string", "format": "did" },
        "fields": {
          "type": "array",
          "description": "Only listed fields override defaults. A listed field with no value explicitly clears it (avatar falls back to Bluesky); remove it from this list to inherit again.",
          "items": { "type": "string", "knownValues": ["displayName", "description", "pronouns", "website", "signature", "avatar", "title", "notifications"] }
        },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "description": { "type": "string", "maxLength": 2560, "maxGraphemes": 256 },
        "pronouns": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "website": { "type": "string", "format": "uri" },
        "title": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "avatar": { "type": "blob", "accept": ["image/png", "image/jpeg", "image/webp", "image/gif"], "maxSize": 1000000 },
        "notifications": { "type": "boolean" },
        "signature": {
          "type": "array",
          "maxLength": 3,
          "items": { "type": "union", "refs": ["app.atmobb.richtext.block#text", "app.atmobb.richtext.block#quote", "app.atmobb.richtext.block#code", "app.atmobb.richtext.block#image"] }
        }
      }
    },
    "forumTheme": {
      "type": "object",
      "required": ["forum", "theme"],
      "properties": {
        "forum": { "type": "string", "format": "did" },
        "theme": { "type": "string", "maxLength": 64, "knownValues": ["", "classic", "sky", "bubblegum", "midnight", "forest"] }
      }
    },
    "avatarBuilder": {
      "type": "object",
      "description": "Legacy built avatar as part + colour choices. Kept so existing records stay valid.",
      "required": ["v", "skin"],
      "properties": {
        "v": { "type": "integer", "description": "Recipe schema version.", "minimum": 1 },
        "skin": { "type": "string", "description": "Skin tone id; drives body, head, nose and facial-feature colouring." },
        "hairBack": { "type": "ref", "ref": "#part" },
        "top": { "type": "ref", "ref": "#garment" },
        "neckwear": { "type": "ref", "ref": "#garment" },
        "facialFeature": { "type": "ref", "ref": "#part" },
        "nose": { "type": "ref", "ref": "#part" },
        "eyes": { "type": "ref", "ref": "#part" },
        "eyebrows": { "type": "ref", "ref": "#part" },
        "mouth": { "type": "ref", "ref": "#part" },
        "facialHair": { "type": "ref", "ref": "#part" },
        "hairFront": { "type": "ref", "ref": "#part" },
        "hat": { "type": "ref", "ref": "#part" },
        "accessory": { "type": "ref", "ref": "#part" }
      }
    },
    "part": {
      "type": "object",
      "description": "A part choice: a shape id and, where the part is colourable, a palette colour id.",
      "required": ["shape"],
      "properties": {
        "shape": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "garment": {
      "type": "object",
      "description": "A garment choice: which type (e.g. jacket, tie) in which colour.",
      "required": ["type", "color"],
      "properties": {
        "type": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  }
}
