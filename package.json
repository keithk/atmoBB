{
  "name": "atmobb",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "scripts": {
    "lex": "yes | lex gen-api ./src/lexicon lexicons/com/atproto/repo/*.json lexicons/app/atmobb/richtext/*.json lexicons/app/atmobb/actor/*.json lexicons/app/atmobb/forum/*.json lexicons/app/atmobb/moderation/*.json lexicons/app/atmobb/discussion/*.json lexicons/app/atmobb/poll/*.json",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && tsc --noEmit -p tsconfig.lexicon.json",
    "test": "vitest run",
    "start": "node build"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.11",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "svelte": "^5.56.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@atproto/lexicon": "^0.7.12",
    "@atproto/oauth-client-node": "^0.5.4",
    "@atproto/xrpc": "^0.8.11",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "postgres": "^3.4.9",
    "satori": "^0.26.0"
  },
  "type": "module"
}
