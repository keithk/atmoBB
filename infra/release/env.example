# atmobb release configuration. `./atmobb install` generates this file as
# `.env` with fresh secrets and keeps it on reruns. Mode 600; it holds every
# credential the stack has.

# Public hostnames. DNS for both must point at this host.
APP_HOST=forum.example.net
HAPPYVIEW_HOST=hv.forum.example.net

# DID of the dedicated forum account (not your personal account).
ATMOBB_FORUM_DID=did:plc:replace-me

# Host directory holding OAuth sessions. Owned by uid 10001.
ATMOBB_DATA_DIR=/var/lib/atmobb/oauth

# Secrets. Generated on install; rotating any of them has consequences listed
# in docs/self-hosting.md.
POSTGRES_PASSWORD=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ATMOBB_COOKIE_SECRET=

# Happyview operator key. Only the setup job and ./atmobb scripts receive it.
HAPPYVIEW_API_KEY=

# Optional.
HAPPYVIEW_CLIENT_KEY=
ATMOBB_AVATAR_BUILDER_URL=

# Uncomment to run the bundled Caddy instead of a host reverse proxy.
# COMPOSE_FILE=compose.yml:compose.caddy.yml
