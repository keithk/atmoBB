#!/bin/sh
# Operator commands for an atmobb release bundle. Run from the bundle
# directory (the one holding compose.yml). Rerunnable: install keeps existing
# secrets and the Happyview operator key.
set -eu
# ATMOBB_INSTANCE_CONFIG_VERSION=1
# ATMOBB_MAINTENANCE_VERSION=1

BUNDLE_DIR=${ATMOBB_BUNDLE_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
cd "$BUNDLE_DIR"
ENV_FILE=$BUNDLE_DIR/.env

usage() {
  cat <<'EOF'
Usage: ./atmobb <command> [options]

  install            First-time setup, or apply a config change. Options:
                       --app-host HOST         public forum hostname
                       --happyview-host HOST   Happyview hostname (default hv.APP_HOST)
                       --admin-handle HANDLE   your personal atproto account
                       --forum-handle HANDLE   the dedicated forum account
                       --caddy                 run the bundled Caddy for TLS
                       --yes                   skip the confirmation prompt
  upgrade            Pull this bundle's images and restart. Refuses to move
                     Happyview; use upgrade-happyview for that.
  upgrade-happyview  Back up, then move Happyview to the version this bundle
                     pins, wait for its migrations, and reapply setup.
  backfill           Index history from the network and rebuild counts.
  backup [DIR]       pg_dump, OAuth state, and .env into DIR
                     (default ./backups/<timestamp>).
  status             Container state and the running atmobb version.
  maintenance on|off|status|recover
                     Gate public traffic and stop writes; reopen only after
                     the durable target passes setup and health checks.
  logs [ARGS]        docker compose logs ARGS
  help

Everything else is `docker compose` in this directory.
EOF
}

die() {
  echo "atmobb: $*" >&2
  exit 1
}

need() {
  for required_command in "$@"; do
    command -v "$required_command" >/dev/null 2>&1 || die "$required_command is required"
  done
}

# The updater and hosting controller run this script as root under systemd's
# NoNewPrivileges, where sudo refuses to start. Use sudo only when not root.
if [ "$(id -u)" -eq 0 ]; then
  as_root() { "$@"; }
else
  as_root() { need sudo; sudo "$@"; }
fi

init_docker() {
  need docker
  if docker info >/dev/null 2>&1; then
    DOCKER=docker
  else
    need sudo
    sudo docker info >/dev/null 2>&1 || die "Docker is not running, or is unavailable to this user and through sudo"
    DOCKER="sudo docker"
  fi
  COMPOSE_VERSION=$($DOCKER compose version --short 2>/dev/null) || die "Docker Compose v2.20 or newer is required"
  COMPOSE_VERSION=${COMPOSE_VERSION#v}
  major=${COMPOSE_VERSION%%.*}
  rest=${COMPOSE_VERSION#*.}
  minor=${rest%%.*}
  [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 20 ]; } ||
    die "Docker Compose v2.20 or newer is required (found $COMPOSE_VERSION)"
}

compose() {
  $DOCKER compose --project-name "$PROJECT" "$@"
}

env_value() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

INSTANCE_ID=$(env_value ATMOBB_INSTANCE_ID)
INSTANCE_ID=${INSTANCE_ID:-atmobb}
case "$INSTANCE_ID" in *[!a-z0-9-]*|-*|*-|'') die "invalid ATMOBB_INSTANCE_ID: use lowercase letters, digits, and hyphens" ;; esac
APP_PORT=$(env_value ATMOBB_APP_PORT); APP_PORT=${APP_PORT:-3001}
HAPPYVIEW_PORT=$(env_value ATMOBB_HAPPYVIEW_PORT); HAPPYVIEW_PORT=${HAPPYVIEW_PORT:-3000}
for port in "$APP_PORT" "$HAPPYVIEW_PORT"; do
  case "$port" in *[!0-9]*|'') die "instance ports must be decimal numbers" ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "instance ports must be between 1 and 65535"
done
[ "$APP_PORT" != "$HAPPYVIEW_PORT" ] || die "ATMOBB_APP_PORT and ATMOBB_HAPPYVIEW_PORT must differ"
if [ "$INSTANCE_ID" = atmobb ]; then
  PROJECT=atmobb; DEFAULT_DATA_DIR=/var/lib/atmobb/oauth; UPDATER_SOCKET_DIR=/run/atmobb-updater
  UPDATER_STATE_DIR=/var/lib/atmobb-updater; UPDATER_LIB_DIR=/usr/local/lib/atmobb
  UPDATER_ENV_FILE=/etc/atmobb/updater.env; UPDATER_UNIT=atmobb-updater.service
else
  PROJECT=atmobb-$INSTANCE_ID; DEFAULT_DATA_DIR=/var/lib/atmobb/$INSTANCE_ID/oauth; UPDATER_SOCKET_DIR=/run/atmobb-updater-$INSTANCE_ID
  UPDATER_STATE_DIR=/var/lib/atmobb-updater-$INSTANCE_ID; UPDATER_LIB_DIR=/usr/local/lib/atmobb-$INSTANCE_ID
  UPDATER_ENV_FILE=/etc/atmobb/updater-$INSTANCE_ID.env; UPDATER_UNIT=atmobb-updater-$INSTANCE_ID.service
fi
PROJECT=${ATMOBB_COMPOSE_PROJECT:-$PROJECT}
state_dir=${ATMOBB_UPDATER_STATE_DIR:-$UPDATER_STATE_DIR}
maintenance_default=/var/lib/atmobb-maintenance
[ "$INSTANCE_ID" = atmobb ] || maintenance_default=$maintenance_default-$INSTANCE_ID
MAINTENANCE_DIR=${ATMOBB_MAINTENANCE_DIR:-$(env_value ATMOBB_MAINTENANCE_DIR)}
MAINTENANCE_DIR=${MAINTENANCE_DIR:-$maintenance_default}
MARKER=$MAINTENANCE_DIR/active
RECOVERY=$state_dir/maintenance-target

# File locks survive worker execution but release automatically on failure or
# reboot. Daemon _update already owns the host lock: never acquire it twice.
with_locks() {
  need python3
  exec python3 -c '
import fcntl, os, subprocess, sys
state, host, script, command, *args = sys.argv[1:]
os.makedirs(state, mode=0o700, exist_ok=True)
os.chmod(state, 0o700)
locks = []
try:
    paths = ([host] if command in ("upgrade", "upgrade-happyview") else [])
    paths.append(os.path.join(state, "maintenance.lock"))
    for path in paths:
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
        locks.append(fd)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit("atmobb: another update or maintenance operation is running")
env = dict(os.environ, ATMOBB_MAINTENANCE_LOCKED="1")
sys.exit(subprocess.call(["sh", script, command, *args], env=env, pass_fds=locks))
' "$state_dir" "${ATMOBB_HOST_UPDATE_LOCK:-/var/lock/atmobb-hosting.lock}" "$0" "$@"
}

# fsync both files and containing directories before destructive work. A
# power loss must not erase the target while leaving migrated databases.
durable() {
  python3 - "$@" <<'PY'
import os, sys
for path in sys.argv[1:]:
    paths = []
    if os.path.isdir(path):
        for root, dirs, files in os.walk(path):
            paths.extend(os.path.join(root, f) for f in files)
            paths.append(root)
    else:
        paths.append(path)
    for item in paths:
        fd = os.open(item, os.O_RDONLY)
        try: os.fsync(fd)
        finally: os.close(fd)
    fd = os.open(os.path.dirname(path), os.O_RDONLY)
    try: os.fsync(fd)
    finally: os.close(fd)
PY
}

target_compose() {
  if [ -f "$RECOVERY/compose.hosting.yml" ]; then
    $DOCKER compose --project-name "$PROJECT" --project-directory "$BUNDLE_DIR" --env-file "$ENV_FILE" \
      -f "$RECOVERY/compose.yml" -f "$RECOVERY/compose.hosting.yml" -f "$RECOVERY/images.json" "$@"
  else
    $DOCKER compose --project-name "$PROJECT" --project-directory "$BUNDLE_DIR" --env-file "$ENV_FILE" \
      -f "$RECOVERY/compose.yml" -f "$RECOVERY/images.json" "$@"
  fi
}

require_maintenance_bundle() {
  grep -q '^# ATMOBB_MAINTENANCE_VERSION=1$' "$1/compose.yml" &&
    grep -q '^# ATMOBB_MAINTENANCE_VERSION=1$' "$1/atmobb" ||
    die "candidate bundle lacks maintenance support; install a maintenance-capable release first"
}

# Persist a complete candidate before enabling the gate. Never replace an
# interrupted target: it may already have run forward-only migrations.
prepare_target() {
  source_bundle=$1
  target_kind=$2
  [ ! -e "$MARKER" ] || die "maintenance is already active; use maintenance recover before another upgrade"
  require_maintenance_bundle "$source_bundle"
  prepared=$(mktemp -d "$state_dir/maintenance-prepared.XXXXXX")
  chmod 700 "$prepared"
  cp "$source_bundle/compose.yml" "$prepared/compose.yml"
  case "$(env_value COMPOSE_FILE)" in
    *:compose.hosting.yml) cp "$source_bundle/compose.hosting.yml" "$prepared/compose.hosting.yml" ;;
    ''|compose.yml|compose.yml:compose.caddy.yml) ;;
    *) die "unsupported COMPOSE_FILE for maintenance" ;;
  esac
  config=$($DOCKER compose --project-name "$PROJECT" --env-file "$ENV_FILE" -f "$prepared/compose.yml" config --format json)
  for service in atmobb happyview setup postgres; do
    if [ "$target_kind" = manual ]; then
      current_service=$service
      [ "$service" != setup ] || current_service=atmobb
      container=$(compose ps -q "$current_service")
      [ -n "$container" ] || die "$current_service must be running to save a manual maintenance target"
      image_id=$($DOCKER inspect --format '{{.Image}}' "$container")
    else
      image_ref=$(printf '%s' "$config" | jq -er --arg s "$service" '.services[$s].image')
      image_id=$($DOCKER image inspect --format '{{.Id}}' "$image_ref")
    fi
    [ -n "$image_id" ] || die "cannot resolve immutable image for $service"
    printf '%s\n' "$image_id" > "$prepared/$service.image"
  done
  metadata=$($DOCKER run --rm --network none --entrypoint node "$(cat "$prepared/atmobb.image")" \
    -p 'JSON.stringify({version:require("./package.json").version,happyview:process.env.HAPPYVIEW_EXPECTED_VERSION})')
  printf '%s' "$metadata" | jq -e '.version | strings | select(length > 0)' >/dev/null
  printf '%s' "$metadata" | jq -e '.happyview | strings | select(length > 0)' >/dev/null
  target_commit=${commit:-}
  if [ "$target_kind" = manual ] && [ -f "$RECOVERY/target.json" ] &&
    cmp -s "$prepared/atmobb.image" "$RECOVERY/atmobb.image" &&
    cmp -s "$prepared/happyview.image" "$RECOVERY/happyview.image"; then
    target_commit=$(jq -r '.commit // ""' "$RECOVERY/target.json")
  fi
  printf '%s\n' "$metadata" | jq --arg commit "$target_commit" \
    '. + {commit: (if $commit == "" then null else $commit end)}' > "$prepared/target.json"
  jq -n --arg app "$(cat "$prepared/atmobb.image")" --arg hv "$(cat "$prepared/happyview.image")" \
    --arg setup "$(cat "$prepared/setup.image")" --arg pg "$(cat "$prepared/postgres.image")" \
    '{services:{atmobb:{image:$app},happyview:{image:$hv},setup:{image:$setup},postgres:{image:$pg}}}' > "$prepared/images.json"
  if [ "$target_kind" = manual ]; then
    : > "$prepared/backup-complete"
  else
    mkdir "$prepared/payload"
    for file in compose.yml compose.hosting.yml atmobb updater.py updater-page.html env.example SELF-HOSTING.md LICENSE; do
      [ ! -f "$source_bundle/$file" ] || cp "$source_bundle/$file" "$prepared/payload/$file"
    done
  fi
  durable "$prepared"
  # No active gate means the old target is no longer needed. A crash in this
  # gap cannot expose partially activated work: activation has not started.
  rm -rf "$RECOVERY"
  mv "$prepared" "$RECOVERY"
  durable "$RECOVERY"
}

verify_gate() {
  for host in "$(env_value APP_HOST)" "$(env_value HAPPYVIEW_HOST)"; do
    valid_hostname "$host" || die "maintenance requires configured public hostnames"
    headers=$(mktemp "$state_dir/gate.XXXXXX")
    code=$(curl --silent --show-error --connect-timeout 5 --max-time 15 \
      --dump-header "$headers" --output /dev/null --write-out '%{http_code}' "https://$host/") ||
      die "cannot verify maintenance gate for $host; leaving maintenance active"
    if [ "$code" != 503 ] || ! tr -d '\r' < "$headers" | grep -Eiq '^X-Atmobb-Maintenance: 1[[:space:]]*$'; then
      rm -f "$headers"
      die "$host is not maintenance-gated; explicitly install/configure the proxy before updating"
    fi
    rm -f "$headers"
  done
}

gate_and_stop() {
  install -d -m 755 "$MAINTENANCE_DIR"
  [ -e "$MARKER" ] || install -m 644 /dev/null "$MARKER"
  durable "$MAINTENANCE_DIR"
  verify_gate
  # Stop the app and Happyview ingestion before pg_dump; leave Postgres and
  # Caddy running. Compose waits for graceful shutdown before returning.
  compose stop --timeout 60 atmobb happyview
}

resume_target() {
  [ -f "$RECOVERY/target.json" ] && [ -f "$RECOVERY/images.json" ] ||
    die "no durable maintenance target; refusing to reopen a potentially partial upgrade"
  gate_and_stop
  if [ ! -f "$RECOVERY/backup-complete" ]; then
    backup=$(cmd_backup)
    durable "$backup"
    printf '%s\n' "$backup" > "$RECOVERY/backup-complete.tmp"
    mv "$RECOVERY/backup-complete.tmp" "$RECOVERY/backup-complete"
    durable "$RECOVERY"
  fi
  # Publish the durable backup before any migration can fail, including retries.
  backup=$(cat "$RECOVERY/backup-complete")
  [ -z "$backup" ] || echo "ATMOBB_BACKUP=$backup"
  if [ -d "$RECOVERY/payload" ]; then
    for file in "$RECOVERY"/payload/*; do
      [ -f "$file" ] || continue
      name=${file##*/}
      case "$name" in atmobb|updater.py) mode=755 ;; *) mode=644 ;; esac
      install -m "$mode" "$file" "$BUNDLE_DIR/$name.maintenance-tmp"
      mv "$BUNDLE_DIR/$name.maintenance-tmp" "$BUNDLE_DIR/$name"
    done
    if [ -f "$BUNDLE_DIR/updater.py" ]; then
      updater_lib=${ATMOBB_UPDATER_LIB_DIR:-$UPDATER_LIB_DIR}
      install -d -m 755 "$updater_lib"
      for name in updater.py atmobb updater-page.html; do
        case "$name" in updater-page.html) mode=644 ;; *) mode=755 ;; esac
        install -m "$mode" "$BUNDLE_DIR/$name" "$updater_lib/$name.maintenance-tmp"
        mv "$updater_lib/$name.maintenance-tmp" "$updater_lib/$name"
      done
    fi
    durable "$BUNDLE_DIR/compose.yml"
  fi
  target_compose up -d postgres happyview
  wait_for_happyview target_compose
  target_compose up --no-deps --force-recreate --exit-code-from setup setup
  setup_id=$(target_compose ps -a -q setup)
  [ -n "$setup_id" ] && [ "$($DOCKER inspect --format '{{.State.ExitCode}}' "$setup_id")" = 0 ] &&
    [ "$($DOCKER inspect --format '{{.Image}}' "$setup_id")" = "$(cat "$RECOVERY/setup.image")" ] ||
    die "target setup did not finish successfully"
  target_compose up -d --no-deps atmobb
  attempt=0
  until response=$(curl --silent --fail --connect-timeout 2 --max-time 5 "http://127.0.0.1:$APP_PORT/api/version"); do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 90 ] || die "atmobb did not become healthy; maintenance remains active"
    sleep 2
  done
  expected_version=$(jq -er .version "$RECOVERY/target.json")
  expected_hv=$(jq -er .happyview "$RECOVERY/target.json")
  [ "$(printf '%s' "$response" | jq -er .version)" = "$expected_version" ] ||
    die "atmobb version differs from durable target; maintenance remains active"
  [ "$(printf '%s' "$response" | jq -er .happyview)" = "$expected_hv" ] ||
    die "atmobb expects a different Happyview version"
  hv_response=$(curl --silent --fail --connect-timeout 2 --max-time 5 \
    -H "Host: $(env_value HAPPYVIEW_HOST)" "http://127.0.0.1:$HAPPYVIEW_PORT/config")
  [ "$(printf '%s' "$hv_response" | jq -er .version)" = "$expected_hv" ] ||
    die "Happyview version differs from durable target"
  for service in atmobb happyview postgres; do
    container=$(target_compose ps --status running -q "$service")
    [ -n "$container" ] && [ "$($DOCKER inspect --format '{{.Image}}' "$container")" = "$(cat "$RECOVERY/$service.image")" ] ||
      die "$service does not run the durable target image"
  done
  verify_gate
  jq --arg backup "$(cat "$RECOVERY/backup-complete")" \
    '{installedVersion:.version, installedCommit:.commit, backup:$backup}' "$RECOVERY/target.json" > "$state_dir/result.json.tmp"
  mv "$state_dir/result.json.tmp" "$state_dir/result.json"
  durable "$state_dir/result.json"
  rm -f "$MARKER"
  durable "$MAINTENANCE_DIR"
  echo "== target healthy; maintenance off"
}

cmd_maintenance() {
  case "${1:-status}" in
    status)
      if [ -e "$MARKER" ]; then echo '{"active":true}'; else echo '{"active":false}'; fi ;;
    on)
      need curl jq python3
      if [ ! -e "$MARKER" ]; then prepare_target "$BUNDLE_DIR" manual; fi
      gate_and_stop ;;
    off|recover)
      need curl jq python3
      [ -e "$MARKER" ] || { echo "maintenance is already off"; return; }
      resume_target ;;
    *) die "usage: maintenance on|off|status|recover" ;;
  esac
}

# Replace KEY=... in .env, or append it. Keeps the file at mode 600.
set_env() {
  key=$1
  value=$2
  tmp=$(mktemp)
  if [ -f "$ENV_FILE" ] && grep -q "^$key=" "$ENV_FILE"; then
    awk -v key="$key" -v value="$value" \
      'index($0, key "=") == 1 { print key "=" value; next } { print }' "$ENV_FILE" > "$tmp"
  else
    [ ! -f "$ENV_FILE" ] || cat "$ENV_FILE" > "$tmp"
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  install -m 600 "$tmp" "$ENV_FILE"
  rm -f "$tmp"
}

# Image reference the bundle pins, and the immutable image its container runs.
pinned_image() {
  compose config --format json | jq -er --arg s "$1" '.services[$s].image'
}
running_image() {
  id=$(compose ps -q "$1" 2>/dev/null | head -n 1)
  [ -n "$id" ] || return 0
  $DOCKER inspect --format '{{.Image}}' "$id"
}

wait_for_happyview() {
  echo "== waiting for Happyview"
  "${1:-compose}" run --rm --no-deps setup sh -c '
    attempt=0
    until curl --fail --silent --connect-timeout 2 --max-time 5 --output /dev/null http://happyview:3000/health; do
      attempt=$((attempt + 1))
      [ "$attempt" -lt 90 ] || { echo "Happyview did not become healthy in 3 minutes" >&2; exit 1; }
      sleep 2
    done
    curl --silent --connect-timeout 2 --max-time 5 -H "Host: $HAPPYVIEW_HOST" http://happyview:3000/config | jq -r "\"Happyview \" + .version"
  '
}

confirm() {
  [ "${ASSUME_YES:-0}" -eq 1 ] && return 0
  printf '\n%s [y/N] ' "$1"
  IFS= read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "Cancelled."; exit 0 ;;
  esac
}

valid_hostname() {
  hostname=$1
  case "$hostname" in
    *[!a-z0-9.-]*|.*|*.|*..*|'') return 1 ;;
  esac
  [ "${#hostname}" -le 253 ] || return 1
  old_ifs=$IFS
  IFS=.
  set -- $hostname
  IFS=$old_ifs
  [ "$#" -ge 2 ] || return 1
  for label do
    [ "${#label}" -le 63 ] || return 1
    case "$label" in
      -*|*-|'') return 1 ;;
    esac
  done
}

resolve_handle() {
  did=$(curl --fail --silent --show-error --get \
    --data-urlencode "handle=$1" \
    https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle |
    jq -er .did) || die "could not resolve atproto handle: $1"
  printf '%s\n' "$did" | grep -Eq '^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$' || die "$1 resolved to an invalid DID"
  printf '%s' "$did"
}

prompt() {
  label=$1
  value=$2
  if [ -n "$value" ]; then
    printf '%s' "$value"
    return
  fi
  [ -t 0 ] || die "$label is required in non-interactive mode"
  printf '%s: ' "$label" >&2
  IFS= read -r value
  [ -n "$value" ] || die "$label cannot be empty"
  printf '%s' "$value"
}

cmd_install() {
  need curl jq openssl python3
  case "$BUNDLE_DIR" in
    *[!A-Za-z0-9_./-]*) die "the bundle path cannot contain spaces or shell metacharacters: $BUNDLE_DIR" ;;
  esac
  APP_HOST=$(env_value APP_HOST)
  HAPPYVIEW_HOST=$(env_value HAPPYVIEW_HOST)
  ADMIN_HANDLE=
  FORUM_HANDLE=
  USE_CADDY=0
  ASSUME_YES=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app-host) [ "$#" -ge 2 ] || die "--app-host needs a value"; APP_HOST=$2; shift 2 ;;
      --happyview-host) [ "$#" -ge 2 ] || die "--happyview-host needs a value"; HAPPYVIEW_HOST=$2; shift 2 ;;
      --admin-handle) [ "$#" -ge 2 ] || die "--admin-handle needs a value"; ADMIN_HANDLE=$2; shift 2 ;;
      --forum-handle) [ "$#" -ge 2 ] || die "--forum-handle needs a value"; FORUM_HANDLE=$2; shift 2 ;;
      --caddy) USE_CADDY=1; shift ;;
      --yes) ASSUME_YES=1; shift ;;
      *) die "unknown option: $1 (try ./atmobb help)" ;;
    esac
  done

  APP_HOST=$(prompt "Public forum hostname" "$APP_HOST")
  HAPPYVIEW_HOST=${HAPPYVIEW_HOST:-hv.$APP_HOST}
  valid_hostname "$APP_HOST" || die "invalid app hostname: $APP_HOST (use lowercase DNS syntax)"
  valid_hostname "$HAPPYVIEW_HOST" || die "invalid Happyview hostname: $HAPPYVIEW_HOST"
  [ "$APP_HOST" != "$HAPPYVIEW_HOST" ] || die "the app and Happyview need different hostnames"

  existing_host=$(env_value APP_HOST)
  if [ -n "$existing_host" ] && [ "$existing_host" != "$APP_HOST" ]; then
    die ".env belongs to $existing_host, not $APP_HOST; move the forum deliberately or start a new bundle"
  fi

  FORUM_DID=$(env_value ATMOBB_FORUM_DID)
  if [ -z "$FORUM_DID" ]; then
    FORUM_HANDLE=$(prompt "Dedicated forum handle" "$FORUM_HANDLE")
  fi
  if [ -z "$(env_value HAPPYVIEW_API_KEY)" ]; then
    ADMIN_HANDLE=$(prompt "Personal admin handle" "$ADMIN_HANDLE")
  fi

  echo "== resolving atproto accounts"
  ADMIN_DID=
  [ -z "$ADMIN_HANDLE" ] || ADMIN_DID=$(resolve_handle "$ADMIN_HANDLE")
  if [ -z "$FORUM_DID" ]; then
    FORUM_DID=$(resolve_handle "$FORUM_HANDLE")
  elif [ -n "$FORUM_HANDLE" ] && [ "$(resolve_handle "$FORUM_HANDLE")" != "$FORUM_DID" ]; then
    die ".env is configured for forum $FORUM_DID, which is not $FORUM_HANDLE"
  fi
  [ -z "$ADMIN_DID" ] || [ "$ADMIN_DID" != "$FORUM_DID" ] ||
    die "the forum must use a dedicated account, not the personal admin account"

  DATA_DIR=$(env_value ATMOBB_DATA_DIR)
  DATA_DIR=${DATA_DIR:-$DEFAULT_DATA_DIR}

  cat <<EOF

atmobb bundle:   $BUNDLE_DIR
Forum:           https://$APP_HOST
Happyview:       https://$HAPPYVIEW_HOST
Forum identity:  ${FORUM_HANDLE:-$FORUM_DID} ($FORUM_DID)
First admin:     ${ADMIN_HANDLE:-already bootstrapped}${ADMIN_DID:+ ($ADMIN_DID)}
OAuth state:     $DATA_DIR
TLS:             $([ "$USE_CADDY" -eq 1 ] && echo "bundled Caddy (ports 80/443)" || echo "your own reverse proxy -> 127.0.0.1:$APP_PORT and :$HAPPYVIEW_PORT")

DNS for both hostnames must point here. Existing secrets are preserved.
EOF
  confirm "Continue?"

  echo "== writing .env"
  umask 077
  set_env APP_HOST "$APP_HOST"
  set_env HAPPYVIEW_HOST "$HAPPYVIEW_HOST"
  set_env ATMOBB_INSTANCE_ID "$INSTANCE_ID"
  set_env COMPOSE_PROJECT_NAME "$PROJECT"
  set_env ATMOBB_APP_PORT "$APP_PORT"
  set_env ATMOBB_HAPPYVIEW_PORT "$HAPPYVIEW_PORT"
  set_env ATMOBB_UPDATER_SOCKET_DIR "$UPDATER_SOCKET_DIR"
  set_env ATMOBB_UPDATER_PUBLIC_SOCKET_DIR "$UPDATER_SOCKET_DIR-public"
  set_env ATMOBB_MAINTENANCE_DIR "$MAINTENANCE_DIR"
  set_env ATMOBB_FORUM_DID "$FORUM_DID"
  set_env ATMOBB_DATA_DIR "$DATA_DIR"
  [ -n "$(env_value POSTGRES_PASSWORD)" ] || set_env POSTGRES_PASSWORD "$(openssl rand -hex 24)"
  [ -n "$(env_value SESSION_SECRET)" ] || set_env SESSION_SECRET "$(openssl rand -hex 32)"
  [ -n "$(env_value TOKEN_ENCRYPTION_KEY)" ] || set_env TOKEN_ENCRYPTION_KEY "$(openssl rand -base64 32)"
  [ -n "$(env_value ATMOBB_COOKIE_SECRET)" ] || set_env ATMOBB_COOKIE_SECRET "$(openssl rand -hex 32)"
  [ -n "$(env_value ATMOBB_UPDATER_TOKEN)" ] || set_env ATMOBB_UPDATER_TOKEN "$(openssl rand -hex 32)"
  if [ "$USE_CADDY" -eq 1 ]; then
    set_env COMPOSE_FILE "compose.yml:compose.caddy.yml"
  fi

  echo "== preparing $DATA_DIR (owned by uid 10001, the container's atmobb user)"
  as_root install -d -m 700 "$DATA_DIR"
  as_root chown 10001:10001 "$DATA_DIR"

  echo "== installing the restricted host updater"
  as_root install -d -m 755 "$MAINTENANCE_DIR"
  as_root install -d -m 755 "$UPDATER_LIB_DIR" /etc/atmobb
  as_root install -m 755 "$BUNDLE_DIR/updater.py" "$UPDATER_LIB_DIR/updater.py"
  as_root install -m 755 "$BUNDLE_DIR/atmobb" "$UPDATER_LIB_DIR/atmobb"
  as_root install -m 644 "$BUNDLE_DIR/updater-page.html" "$UPDATER_LIB_DIR/updater-page.html"
  updater_env=$(mktemp)
  updater_unit=$(mktemp)
  python_bin=$(command -v python3)
  trap 'rm -f "$updater_env" "$updater_unit"' EXIT HUP INT TERM
  umask 077
  cat > "$updater_env" <<EOF
ATMOBB_BUNDLE_DIR=$BUNDLE_DIR
APP_HOST=$APP_HOST
ATMOBB_UPDATER_TOKEN=$(env_value ATMOBB_UPDATER_TOKEN)
ATMOBB_UPDATER_SOCKET_GID=10001
ATMOBB_UPDATER_SOCKET=$UPDATER_SOCKET_DIR/updater.sock
ATMOBB_UPDATER_PUBLIC_SOCKET=$UPDATER_SOCKET_DIR-public/updater.sock
ATMOBB_MAINTENANCE_DIR=$MAINTENANCE_DIR
ATMOBB_UPDATER_STATE_DIR=$UPDATER_STATE_DIR
ATMOBB_UPDATER_WORKER=$UPDATER_LIB_DIR/atmobb
ATMOBB_UPDATER_LIB_DIR=$UPDATER_LIB_DIR
ATMOBB_HOST_UPDATE_LOCK=/var/lock/atmobb-hosting.lock
EOF
  as_root install -m 600 "$updater_env" "$UPDATER_ENV_FILE"
  cat > "$updater_unit" <<EOF
[Unit]
Description=atmobb restricted host updater
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=$UPDATER_ENV_FILE
ExecStart=$python_bin $UPDATER_LIB_DIR/updater.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
  as_root install -m 644 "$updater_unit" "/etc/systemd/system/$UPDATER_UNIT"
  rm -f "$updater_env" "$updater_unit"
  trap - EXIT HUP INT TERM
  as_root systemctl daemon-reload
  as_root systemctl enable --now "$UPDATER_UNIT"
  as_root systemctl restart "$UPDATER_UNIT"
  attempt=0
  while ! as_root test -S "$UPDATER_SOCKET_DIR/updater.sock"; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 20 ] || die "the updater did not create its socket; inspect: sudo journalctl -u $UPDATER_UNIT"
    sleep 1
  done

  echo "== starting Postgres and Happyview"
  compose config --quiet
  compose pull
  compose up -d postgres happyview
  wait_for_happyview

  if [ -z "$(env_value HAPPYVIEW_API_KEY)" ]; then
    echo "== creating the Happyview operator key"
    key_output=$(compose run --rm --no-deps -e "ADMIN_DID=$ADMIN_DID" setup sh appview/bootstrap-admin.sh) ||
      die "Happyview bootstrap failed; inspect 'docker compose logs happyview' and rerun"
    key=$(printf '%s\n' "$key_output" | sed -n 's/^HAPPYVIEW_API_KEY=//p' | tail -n 1)
    [ -n "$key" ] || die "bootstrap did not print an operator key"
    set_env HAPPYVIEW_API_KEY "$key"
  else
    echo "== keeping the existing Happyview operator key"
  fi

  echo "== configuring Happyview and starting atmobb"
  compose up -d
  cmd_status

  cat <<EOF

Installation complete.

1. Open https://$APP_HOST and log in with your personal account.
2. Open https://$APP_HOST/admin and connect the forum account when prompted.
3. Create the forum profile and first board in /admin.
4. Run './atmobb backfill' to index records that already exist on the network.
EOF
  if [ "$USE_CADDY" -eq 1 ]; then
    echo "Caddy may take a moment to obtain certificates after DNS reaches this host."
  else
    echo "Point your reverse proxy at 127.0.0.1:$APP_PORT (forum) and 127.0.0.1:$HAPPYVIEW_PORT (Happyview),"
    echo "and block /admin on the Happyview hostname. docs/self-hosting.md has a Caddy example."
  fi
}

cmd_upgrade() {
  need jq curl python3
  [ -f "$ENV_FILE" ] || die "no .env here; run ./atmobb install first"
  [ ! -e "$MARKER" ] || die "maintenance is active; run maintenance recover"
  require_maintenance_bundle "$BUNDLE_DIR"
  echo "== pulling images"
  compose pull
  pinned=$(pinned_image happyview)
  pinned_id=$($DOCKER image inspect --format '{{.Id}}' "$pinned")
  running=$(running_image happyview)
  if [ -n "$running" ] && [ "$running" != "$pinned_id" ]; then
    cat >&2 <<EOF
atmobb: this bundle pins $pinned but $running is running.

Happyview upgrades run forward-only database migrations. Back up first, then
run './atmobb upgrade-happyview' to move the stack together.
EOF
    exit 1
  fi
  prepare_target "$BUNDLE_DIR" upgrade
  resume_target
}

cmd_upgrade_happyview() {
  need jq curl python3
  ASSUME_YES=0
  [ "${1:-}" != "--yes" ] || ASSUME_YES=1
  [ -f "$ENV_FILE" ] || die "no .env here; run ./atmobb install first"
  pinned=$(pinned_image happyview)
  running=$(running_image happyview)
  [ ! -e "$MARKER" ] || die "maintenance is active; run maintenance recover"
  require_maintenance_bundle "$BUNDLE_DIR"
  cat <<EOF

Happyview:  ${running:-not running}  ->  $pinned

Startup runs forward-only migrations. Once they finish you cannot go back down
a version. A backup is taken first.
EOF
  confirm "Upgrade Happyview?"
  echo "== preparing images before maintenance"
  compose pull
  prepare_target "$BUNDLE_DIR" upgrade
  resume_target
  cat <<EOF

Done. If the release notes ask for it, run './atmobb backfill' now to rebuild
derived tables against the new schema.
EOF
}

cmd_backfill() {
  [ -f "$ENV_FILE" ] || die "no .env here; run ./atmobb install first"
  compose run --rm --no-deps setup sh appview/backfill.sh
}

cmd_backup() {
  [ -f "$ENV_FILE" ] || die "no .env here; run ./atmobb install first"
  if [ "$#" -gt 0 ]; then
    dir=$1
    [ ! -e "$dir" ] || die "backup destination already exists: $dir"
    mkdir -m 700 -p "$dir"
  else
    mkdir -p "$BUNDLE_DIR/backups"
    dir=$(mktemp -d "$BUNDLE_DIR/backups/$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")
  fi
  data_dir=$(env_value ATMOBB_DATA_DIR)
  data_dir=${data_dir:-$DEFAULT_DATA_DIR}
  umask 077
  mkdir -p "$dir"
  echo "== backing up to $dir" >&2
  compose exec -T postgres pg_dump -Fc -U happyview -d happyview > "$dir/postgres.dump" || return 1
  as_root tar -C "$(dirname "$data_dir")" -czf - "$(basename "$data_dir")" > "$dir/oauth.tar.gz" || return 1
  cp "$ENV_FILE" "$dir/env" || return 1
  cp "$BUNDLE_DIR/compose.yml" "$dir/compose.yml" || return 1
  for file in compose.caddy.yml compose.hosting.yml Caddyfile; do
    [ ! -f "$BUNDLE_DIR/$file" ] || cp "$BUNDLE_DIR/$file" "$dir/$file"
  done
  ls -lh "$dir" >&2
  echo "These files contain credentials and private data. Copy them off this host." >&2
  printf '%s\n' "$dir"
}

cmd_status() {
  compose ps
  version=$(curl --silent --fail "http://127.0.0.1:$APP_PORT/api/version" 2>/dev/null) &&
    printf 'atmobb %s (expects Happyview %s)\n' \
      "$(printf '%s' "$version" | jq -r .version)" "$(printf '%s' "$version" | jq -r .happyview)" ||
    echo "atmobb is not answering on 127.0.0.1:$APP_PORT yet"
}

# Called only by the root-owned updater daemon. Preparation (downloads, pulls,
# or a source build) finishes before backup and before the running stack moves.
cmd_internal_update() {
  target=${1:-}
  token=$(env_value ATMOBB_UPDATER_TOKEN)
  [ -n "$token" ] && [ "${ATMOBB_UPDATER_INTERNAL:-}" = "$token" ] || die "_update is reserved for atmobb-updater"
  [ "$target" = stable ] || [ "$target" = main ] || die "update target must be stable or main"
  [ ! -e "$MARKER" ] || die "maintenance is active; recover the durable target before another update"
  need curl jq openssl tar
  state_dir=${ATMOBB_UPDATER_STATE_DIR:-$UPDATER_STATE_DIR}
  release_api=${ATMOBB_UPDATE_RELEASE_API:-https://api.github.com/repos/keithk/atmoBB/releases/latest}
  main_api=${ATMOBB_UPDATE_MAIN_API:-https://api.github.com/repos/keithk/atmoBB/commits/main}
  archive_base=${ATMOBB_UPDATE_ARCHIVE_BASE:-https://github.com/keithk/atmoBB/archive}
  work=$state_dir/work.$$
  compose_files=$(env_value COMPOSE_FILE)
  case "$compose_files" in
    ''|compose.yml|compose.yml:compose.caddy.yml|compose.yml:compose.hosting.yml) ;;
    *) die "unsupported COMPOSE_FILE for automatic updates; use a documented release overlay" ;;
  esac
  rm -rf "$work"
  mkdir -p "$work/bundle"
  trap 'rm -rf "$work"' EXIT HUP INT TERM

  if [ "$target" = stable ]; then
    echo "== resolving latest stable release"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      -H 'Accept: application/vnd.github+json' -H 'User-Agent: atmobb-updater' \
      "$release_api" -o "$work/release.json"
    tag=$(jq -er '.tag_name | select(type == "string" and test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))' "$work/release.json") ||
      die "latest GitHub release has no valid version tag"
    version=${tag#v}
    asset=atmobb-$version.tar.gz
    bundle_url=$(jq -er --arg n "$asset" '.assets[] | select(.name == $n) | .browser_download_url' "$work/release.json") || die "$asset is missing"
    sums_url=$(jq -er '.assets[] | select(.name == "SHA256SUMS") | .browser_download_url' "$work/release.json") || die "SHA256SUMS is missing"
    echo "== downloading and verifying $tag"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 "$bundle_url" -o "$work/$asset"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 "$sums_url" -o "$work/SHA256SUMS"
    expected=$(awk -v name="$asset" '$2 == name || $2 == "*" name { print tolower($1); exit }' "$work/SHA256SUMS")
    case "$expected" in *[!0-9a-f]*|'') die "release checksum is invalid" ;; esac
    [ "${#expected}" -eq 64 ] || die "release checksum has the wrong length"
    actual=$(openssl dgst -sha256 "$work/$asset" | awk '{print tolower($NF)}')
    [ "$actual" = "$expected" ] || die "release checksum verification failed"
    tar -xzf "$work/$asset" --strip-components=1 -C "$work/bundle"
    require_maintenance_bundle "$work/bundle"
    grep -q '^# ATMOBB_INSTANCE_CONFIG_VERSION=1$' "$work/bundle/compose.yml" &&
      grep -q '^# ATMOBB_INSTANCE_CONFIG_VERSION=1$' "$work/bundle/atmobb" ||
      die "candidate release does not support isolated instance configuration"
    echo "== pulling pinned release images before changing the stack"
    stage_compose="$DOCKER compose --project-name $PROJECT --env-file $ENV_FILE -f $work/bundle/compose.yml"
    case "$compose_files" in
      *:compose.caddy.yml) stage_compose="$stage_compose -f $work/bundle/compose.caddy.yml" ;;
      *:compose.hosting.yml) stage_compose="$stage_compose -f $work/bundle/compose.hosting.yml" ;;
    esac
    $stage_compose pull
    commit=
  else
    echo "== resolving main to an exact commit"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      -H 'Accept: application/vnd.github+json' -H 'User-Agent: atmobb-updater' \
      "$main_api" -o "$work/commit.json"
    commit=$(jq -er '.sha | select(type == "string" and test("^[0-9a-f]{40}$"))' "$work/commit.json") || die "GitHub returned an invalid main commit"
    echo "== downloading main@$commit"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 3 \
      "$archive_base/$commit.tar.gz" -o "$work/main.tar.gz"
    mkdir "$work/source"
    tar -xzf "$work/main.tar.gz" --strip-components=1 -C "$work/source"
    require_maintenance_bundle "$work/source/infra/release"
    grep -q '^# ATMOBB_INSTANCE_CONFIG_VERSION=1$' "$work/source/infra/release/compose.yml" &&
      grep -q '^# ATMOBB_INSTANCE_CONFIG_VERSION=1$' "$work/source/infra/release/atmobb" ||
      die "candidate main bundle does not support isolated instance configuration"
    version=$(jq -er .version "$work/source/package.json")
    happyview=$(sed -n 's/^ARG HAPPYVIEW_VERSION=//p' "$work/source/Dockerfile")
    [ -n "$happyview" ] || die "main has no Happyview version pin"
    image="atmobb-main:$commit"
    echo "== building $image before changing the running stack"
    $DOCKER build --build-arg "HAPPYVIEW_VERSION=$happyview" -t "$image" "$work/source"
    for file in compose.yml compose.caddy.yml compose.hosting.yml Caddyfile atmobb updater.py updater-page.html env.example; do
      cp "$work/source/infra/release/$file" "$work/bundle/$file"
    done
    cp "$work/source/docs/self-hosting.md" "$work/bundle/SELF-HOSTING.md"
    cp "$work/source/LICENSE" "$work/bundle/"
    sed "s#ghcr.io/keithk/atmobb:[0-9][0-9A-Za-z.+-]*#$image#g" "$work/bundle/compose.yml" > "$work/bundle/compose.yml.tmp"
    mv "$work/bundle/compose.yml.tmp" "$work/bundle/compose.yml"
    echo "== pulling main's pinned infrastructure images"
    stage_compose="$DOCKER compose --project-name $PROJECT --env-file $ENV_FILE -f $work/bundle/compose.yml"
    case "$compose_files" in
      *:compose.caddy.yml) stage_compose="$stage_compose -f $work/bundle/compose.caddy.yml" ;;
      *:compose.hosting.yml) stage_compose="$stage_compose -f $work/bundle/compose.hosting.yml" ;;
    esac
    $stage_compose pull postgres happyview
    [ "$compose_files" != compose.yml:compose.caddy.yml ] || $stage_compose pull caddy
  fi
  echo "ATMOBB_TARGET_VERSION=$version"
  echo "ATMOBB_TARGET_COMMIT=$commit"

  prepare_target "$work/bundle" upgrade
  [ "$(jq -er .version "$RECOVERY/target.json")" = "$version" ] ||
    die "prepared image version does not match requested release"
  resume_target
  echo "== update complete and healthy"
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
# Read-only status needs neither Docker nor access to the private updater
# directory. It is safe to read concurrently with the atomic public marker.
if [ "$command" = maintenance ] && [ "${1:-status}" = status ]; then
  cmd_maintenance status
  exit
fi
case "$command" in
  upgrade|upgrade-happyview|_update|maintenance)
    [ "$(id -u)" -eq 0 ] ||
      die "this command needs root to lock private updater state; rerun: sudo $0 $command $*"
    if [ "${ATMOBB_MAINTENANCE_LOCKED:-}" != 1 ]; then
      with_locks "$command" "$@"
    fi ;;
esac
init_docker
case "$command" in
  install) cmd_install "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  upgrade-happyview) cmd_upgrade_happyview "$@" ;;
  backfill) cmd_backfill "$@" ;;
  backup) cmd_backup "$@" >/dev/null ;;
  status) cmd_status ;;
  maintenance) cmd_maintenance "$@" ;;
  logs) compose logs "$@" ;;
  _update) cmd_internal_update "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command (try ./atmobb help)" ;;
esac
